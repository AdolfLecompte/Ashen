# btop theme generated by Ashen -- do NOT edit by hand, regenerated with the
# wallpaper. Neutrals follow matugen's surfaces; the three gradient stops that
# btop uses for every meter run accent -> secondary -> tertiary, so a graph
# reads as one sweep of the scheme rather than three unrelated hues.

theme[main_bg]="{{colors.surface_dim.default.hex}}"
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="__ASHEN_ACCENT__"
theme[hi_fg]="{{colors.tertiary.default.hex}}"
theme[selected_bg]="{{colors.surface_container_high.default.hex}}"
theme[selected_fg]="{{colors.on_surface.default.hex}}"
theme[inactive_fg]="{{colors.on_surface_variant.default.hex}}"
theme[proc_misc]="__ASHEN_ACCENT2__"
theme[cpu_box]="{{colors.outline.default.hex}}"
theme[mem_box]="{{colors.outline.default.hex}}"
theme[net_box]="{{colors.outline.default.hex}}"
theme[proc_box]="{{colors.outline.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"
theme[temp_start]="__ASHEN_ACCENT__"
theme[temp_mid]="__ASHEN_ACCENT2__"
theme[temp_end]="{{colors.tertiary.default.hex}}"
theme[cpu_start]="__ASHEN_ACCENT__"
theme[cpu_mid]="__ASHEN_ACCENT2__"
theme[cpu_end]="{{colors.tertiary.default.hex}}"
theme[free_start]="__ASHEN_ACCENT__"
theme[free_mid]="__ASHEN_ACCENT2__"
theme[free_end]="{{colors.tertiary.default.hex}}"
theme[cached_start]="__ASHEN_ACCENT__"
theme[cached_mid]="__ASHEN_ACCENT2__"
theme[cached_end]="{{colors.tertiary.default.hex}}"
theme[available_start]="__ASHEN_ACCENT__"
theme[available_mid]="__ASHEN_ACCENT2__"
theme[available_end]="{{colors.tertiary.default.hex}}"
theme[used_start]="__ASHEN_ACCENT__"
theme[used_mid]="__ASHEN_ACCENT2__"
theme[used_end]="{{colors.tertiary.default.hex}}"
theme[download_start]="__ASHEN_ACCENT__"
theme[download_mid]="__ASHEN_ACCENT2__"
theme[download_end]="{{colors.tertiary.default.hex}}"
theme[upload_start]="__ASHEN_ACCENT__"
theme[upload_mid]="__ASHEN_ACCENT2__"
theme[upload_end]="{{colors.tertiary.default.hex}}"
theme[process_start]="__ASHEN_ACCENT__"
theme[process_mid]="__ASHEN_ACCENT2__"
theme[process_end]="{{colors.tertiary.default.hex}}"
